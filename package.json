{
  "name": "dsh-remote-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "runtime/client",
    "runtime/ssh"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test runtime/tests/client/*.test.ts runtime/tests/bootstrap/*.test.ts integrations/dsh/tests/bindings/*.test.ts integrations/dsh/tests/skills/*.test.ts",
    "test:bootstrap": "node --test runtime/tests/bootstrap/*.test.ts",
    "scan:world-io": "bash integrations/dsh/checks/codeql/scan.sh",
    "test:world-io": "node integrations/dsh/tests/codeql/check.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/headless": "6.0.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "mime-types": "3.0.2",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  }
}
