{
  "name": "dsh-remote-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "runtime/client",
    "runtime/ssh"
  ],
  "scripts": {
    "check": "node integrations/dsh/scripts/develop.mjs check",
    "test": "(cd runtime/helper && cargo test --locked && cargo build --locked --bins) && node --test runtime/tests/client/*.test.ts runtime/tests/bootstrap/*.test.ts integrations/dsh/tests/bindings/*.test.ts integrations/dsh/tests/skills/*.test.ts integrations/dsh/tests/release/*.test.mjs",
    "test:bootstrap": "node --test runtime/tests/bootstrap/*.test.ts",
    "check:runtime": "npm run check:rust && tsc --noEmit",
    "check:rust": "(cd runtime/helper && cargo fmt --all --check && cargo clippy --locked --all-targets -- -D warnings)",
    "test-integration": "node integrations/dsh/scripts/develop.mjs test-integration",
    "test-e2e": "node integrations/dsh/scripts/develop.mjs test-e2e",
    "package": "node integrations/dsh/scripts/develop.mjs package"
  },
  "devDependencies": {
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/headless": "6.0.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "mime-types": "3.0.2",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  }
}
