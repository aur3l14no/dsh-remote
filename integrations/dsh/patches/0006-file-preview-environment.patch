new file mode 100644
index 0000000..40c9080
--- /dev/null
+++ b/packages/client/ui-chat/src/client/file-preview-address.ts
@@ -0,0 +1,9 @@
+import { fileAddressFor, parseFileAddress, sessionFileAddress } from '@deepseek-ai/dsh-util-workspace-path'
+
+/** Keep even root-workspace previews owned by the rendering Session. */
+export function previewAddress(sessionId: string, cwd: string | undefined, absolutePath: string): string {
+  if (!cwd) throw new Error('File preview requires the Session workspace')
+  const address = cwd === '/' ? sessionFileAddress(sessionId, absolutePath) : fileAddressFor(sessionId, cwd, absolutePath)
+  if (parseFileAddress(address)?.scope !== 'session') throw new Error('File preview path is outside the Session workspace')
+  return address
+}
