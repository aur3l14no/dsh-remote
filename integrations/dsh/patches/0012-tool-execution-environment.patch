new file mode 100644
--- /dev/null
+++ b/packages/core/tools/src/execution-environment.ts
@@ -0,0 +1,17 @@
+import type { Context } from '@deepseek-ai/cordis'
+import type { ToolExecution, ToolExecutionResult } from './index.ts'
+
+/** Optional host environment extension; tools retain their ordinary Session default. */
+export interface ToolEnvironment {
+  fileEnvironment(): { cwd: string; base: string } | undefined
+  readonly parameters: Record<string, unknown>
+  run(exec: ToolExecution, next: () => Promise<ToolExecutionResult>): Promise<ToolExecutionResult>
+  fileReference(exec: ToolExecution, path: string): string | undefined
+  cwd(exec: ToolExecution): string | undefined
+}
+declare module '@deepseek-ai/cordis' {
+  interface Context { toolEnvironment: ToolEnvironment }
+}
+export function executionCwd(ctx: Context, exec: ToolExecution): string | undefined {
+  return ctx.get('toolEnvironment')?.cwd(exec) ?? exec.agent?.session.header.cwd
+}
