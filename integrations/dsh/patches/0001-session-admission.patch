diff --git a/packages/api/session-controller/src/admission.ts b/packages/api/session-controller/src/admission.ts
new file mode 100644
--- /dev/null
+++ b/packages/api/session-controller/src/admission.ts
@@ -0,0 +1,28 @@
+/** Optional host policy, awaited before ordinary Session activation or adoption. */
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace'
+
+export interface ApiSessionAdmissionRequest {
+  readonly operation: 'create' | 'resume' | 'adopt' | 'fork'
+  readonly sessionId: SessionId
+  readonly cwd?: string | undefined
+  readonly workspaceId?: WorkspaceId
+  readonly sourceSessionId?: SessionId
+  readonly checkPersistedIdentity?: boolean
+}
+
+export interface ApiSessionAdmission {
+  /** Owns directory preparation when installed; rejection never falls back to local mkdir. */
+  prepare(request: ApiSessionAdmissionRequest): Promise<void>
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context { apiSessionAdmission: ApiSessionAdmission }
+}
+
+/** Admission failure must not be bypassed by raced-Agent adoption. */
+export class ApiSessionAdmissionError extends Error {
+  constructor(cause: unknown) {
+    super(`Session admission failed: ${String(cause)}`, { cause })
+  }
+}
