+/** Optional host seam; selection is opaque to the native child lifecycle. */
+export interface ChildEnvironmentRequest {
+  parent: Agent
+  sessionId: SessionId
+  operation: 'create' | 'resume'
+  selection?: string | undefined
+  seeded: boolean
+  signal: AbortSignal
+}
+export interface ChildEnvironment {
+  /** Recheck saved authority at the native publication barrier. */
+  validate(child: Agent): void
+  cwd: string
+  preset?: string | undefined
+  sandboxMode?: SandboxMode | undefined
+}
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    childExecutionEnvironment: {
+      prepare(request: ChildEnvironmentRequest): Promise<ChildEnvironment>
+    }
+  }
+}
+export async function prepareChildEnvironment(request: ChildEnvironmentRequest): Promise<ChildEnvironment | undefined> {
+  const service = request.parent.ctx.get('childExecutionEnvironment')
+  if (!service && request.selection !== undefined) throw new Error('Explicit child execution requires an environment provider')
+  const environment = await service?.prepare(request)
+  request.signal.throwIfAborted()
+  return environment
+}
